012,0,Glow Plugs
012,1,Glow Status,,00000000 = Waiting for Coolant Temperature\n00000001 = Waiting for ECO Start Request\n00010000 = Pre-Glow\n01010000 = No Pre-Glow\n10110000 = Post-Glow\n11000000 = No Post-Glow\n11110000 = Interim Glow\n00110000 = Readiness Glowing\n01110000 = Glow Start\n10110001 = Waiting for Post-Glow\n11010000 = No Post-Glow\n11110001 = Waiting for Interim Glow\n11111111 = Glowing OFF
; 00000000 = Waiting for Coolant Temperature
; 00000001 = Waiting for ECO Start Request
; 00010000 = Pre-Glow
; 01010000 = No Pre-Glow
; 10110000 = Post-Glow
; 11000000 = No Post-Glow
; 11110000 = Interim Glow
; 00110000 = Readiness Glowing
; 01110000 = Glow Start
; 10110001 = Waiting for Post-Glow
; 11010000 = No Post-Glow
; 11110001 = Waiting for Interim Glow
; 11111111 = Glowing OFF
