001,0,Convertible Top Status (Actual)
001,1,Convertible Top,Control Switch,Range: Open/Closed/Not Oper./Not OK
001,2,Switches &&,Positions I,xxxxxxx? = Convertible Top Open Position Switch (F171)\nxxxxxx?x = Convertible Top Closed Position Switch (F202)\nxxxxx?xx = Convertible Top Lock Switch Open (F294)\nxxxx?xxx = Convertible Top Lock Switch Closed (F295)\nxxx?xxxx = Convertible Top Front Lock Switch (F172)\nxx?xxxxx = Switch Point for Bow UP\nx?xxxxxx = Switch Point for Bow OPEN\n?xxxxxxx = Switch Point for Bow DEAD CENTER\n\n0 = inactive / 1 = active
; xxxxxxx? = Convertible Top Open Position Switch (F171)
; xxxxxx?x = Convertible Top Closed Position Switch (F202)
; xxxxx?xx = Convertible Top Lock Switch Open (F294)
; xxxx?xxx = Convertible Top Lock Switch Closed (F295)
; xxx?xxxx = Convertible Top Front Lock Switch (F172)
; xx?xxxxx = Switch Point for Bow UP
; x?xxxxxx = Switch Point for Bow OPEN
; ?xxxxxxx = Switch Point for Bow DEAD CENTER
; 0 = inactive / 1 = active
001,3,Switches &&,Positions II,xx--xxx? = Compartment Cover Open Position Switch (F201)\nxx--xx?x = Left Convertible Top Compartment Cover Switch (F290)\nxx--x?xx = Convertible Top Compartment Latch Switch UNLOCK (F293)\nxx--?xxx = Compartment Cover Locked Right Switch 1 (F200)\n?x--xxxx = Convertible Top Compartment Encolsure Position Switch (F292)\n\n0 = inactive / 1 = active
; xx--xxx? = Compartment Cover Open Position Switch (F201)
; xx--xx?x = Left Convertible Top Compartment Cover Switch (F290)
; xx--x?xx = Convertible Top Compartment Latch Switch UNLOCK (F293)
; xx--?xxx = Compartment Cover Locked Right Switch 1 (F200)
; ?x--xxxx = Convertible Top Compartment Encolsure Position Switch (F292)
; 0 = inactive / 1 = active
001,4,Top Frame,Position (G356),Range: 0.0...255.0
;
002,1,Vehicle Speed,,Range: 0.0...254.0 km/h\n\n255.0 km/h = Invalid
002,2,Voltage,(Terminal 30),Range: 6.0...18.0 V\nSpecification: 10.6/11.5...16.0 V
002,3,Rear Lid,Contact Switch,Range: Lid Open/Lid Closed
002,4,Window Regulator,Operation,xxxxxxx1 = Window Regulator Driver: Up\nxxxxxx1x = Window Regulator Driver: Down\nxxxxx1xx = Window Regulator Passenger: Up\nxxxx1xxx = Window Regulator Passenger: Down\nxxx1xxxx = Window Regulator Rear Left: Up\nxx1xxxxx = Window Regulator Rear Left: Down\nx1xxxxxx = Window Regulator Rear Right: Up\n1xxxxxxx = Window Regulator Rear Right: Down
; xxxxxxx1 = Window Regulator Driver: Up
; xxxxxx1x = Window Regulator Driver: Down
; xxxxx1xx = Window Regulator Passenger: Up
; xxxx1xxx = Window Regulator Passenger: Down
; xxx1xxxx = Window Regulator Rear Left: Up
; xx1xxxxx = Window Regulator Rear Left: Down
; x1xxxxxx = Window Regulator Rear Right: Up
; 1xxxxxxx = Window Regulator Rear Right: Down
;
