017,0,Readiness Code (EOBD)
017,1,EOBD/CARB,Mode 01 DATA A,x---0000 = No Fault Codes stored\n0---xxxx = MIL OFF\n1---xxxx = MIL ON
; x---0000 = No Fault Codes stored
; 0---xxxx = MIL OFF
; 1---xxxx = MIL ON
017,2,EOBD/CARB,Mode 01 DATA B,-xxx-xx1 = Activation Misfire Recognition OIN\n-xxx-x1x = Activation Fuel Supply System ON\n-xxx-1xx = Activation Comprehensive Components ON\n-xxx-xxx = EOBD-Test Misfire Recognition finished \n-x0x-xxx = EOBD-Test Fuel Supply System finished\n-0xx-xxx = EOBD-Test Comprehensive Components finished
; -xxx-xx1 = Activation Misfire Recognition OIN
; -xxx-x1x = Activation Fuel Supply System ON
; -xxx-1xx = Activation Comprehensive Components ON
; -xxx-xxx = EOBD-Test Misfire Recognition finished 
; -x0x-xxx = EOBD-Test Fuel Supply System finished
; -0xx-xxx = EOBD-Test Comprehensive Components finished
017,3,EOBD/CARB,Mode 01 DATA C,xx1----- = Activation Oxygen/Lambda Sensor ON\nx1x----- = Activation Oxygen/Lambda Sensor Heating ON\n1xx----- = Activation Exhaust Gas Recirculation (EGR) ON
; xx1----- = Activation Oxygen/Lambda Sensor ON
; x1x----- = Activation Oxygen/Lambda Sensor Heating ON
; 1xx----- = Activation Exhaust Gas Recirculation (EGR) ON
017,4,EOBD/CARB,Mode 01 DATA D,xx0----- = EOBD-Test Oxygen/Lambda Sensor finished\nx0x----- = EOBD-Test Oxygen/Lambda Sensor Heating finished\n0xx----- = EOBD-Test Exhaust Gas Recirculation (EGR) finished
; xx0----- = EOBD-Test Oxygen/Lambda Sensor finished
; x0x----- = EOBD-Test Oxygen/Lambda Sensor Heating finished
; 0xx----- = EOBD-Test Exhaust Gas Recirculation (EGR) finished
;
018,0,Injector Status
